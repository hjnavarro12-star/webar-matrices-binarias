{
  "info": {
    "name": "WebAR API — RA-PBI-08",
    "description": "Colección de verificación para health, horario por Pattern, salón inexistente e identificador inválido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://webar-matrices-binarias-production.up.railway.app",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Estado ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Horario del salón 101",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rooms/pattern-101/schedule",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rooms", "pattern-101", "schedule"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Identificador Pattern', () => pm.expect(pm.response.json().room.pattern_marker_id).to.eql('pattern-101'));",
              "pm.test('Schedule es un arreglo', () => pm.expect(pm.response.json().schedule).to.be.an('array'));",
              "pm.test('Responde en menos de 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
            ]
          }
        }
      ]
    },
    {
      "name": "Salón inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rooms/pattern-999/schedule",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rooms", "pattern-999", "schedule"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 404', () => pm.response.to.have.status(404));",
              "pm.test('Mensaje esperado', () => pm.expect(pm.response.json().error).to.eql('Salón no encontrado'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Identificador inválido",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rooms/abc/schedule",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rooms", "abc", "schedule"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 400', () => pm.response.to.have.status(400));",
              "pm.test('Mensaje de validación', () => pm.expect(pm.response.json().error).to.include('Identificador inválido'));"
            ]
          }
        }
      ]
    }
  ]
}
