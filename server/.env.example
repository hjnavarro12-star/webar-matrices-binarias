# WebAR: matrices binarias — Variables de entorno del servidor
# Copiar a .env y completar con los valores reales
# NUNCA subir .env al repositorio

PORT=3001

# Base de datos PostgreSQL (VPS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webar_dev
DB_USER=postgres
DB_PASSWORD=

# JWT para endpoints de administración (RA-PBI-12)
JWT_SECRET=cambia_esto_por_un_secreto_seguro
