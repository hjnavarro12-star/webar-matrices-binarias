# WebAR: matrices binarias — Variables de entorno del servidor
# Copiar a .env y completar con los valores reales
# NUNCA subir .env al repositorio

PORT=3001

# Base de datos PostgreSQL local o Neon
# Neon activa SSL automáticamente al definir DATABASE_URL. Usa sslmode=verify-full. DB_SSL=false es para PostgreSQL local.
DATABASE_URL=
DATABASE_URL_POOLED=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webar_dev
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# JWT para endpoints de administración (RA-PBI-12)
JWT_SECRET=cambia_esto_por_un_secreto_seguro
